#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

*.yml           text eol=lf

# Keep byte-for-byte legacy fixtures stable across Windows and Unix checkouts.
/src/test/resources/compatibility/** text eol=lf
